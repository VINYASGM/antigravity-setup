{
  "lint-enforcer": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.antigravity/scripts/lint-enforcer.js post-tool",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.antigravity/scripts/lint-enforcer.js pre-tool",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../.antigravity/scripts/lint-enforcer.js stop",
        "timeout": 30
      }
    ]
  },
  "branch-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.antigravity/scripts/branch-guard.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "shell-sandbox": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.antigravity/scripts/shell-sandbox.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "knowledge-injector": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ../.antigravity/scripts/knowledge-injector.js",
        "timeout": 10
      }
    ]
  },
  "goal-pr-creator": {
    "Stop": [
      {
        "type": "command",
        "command": "node ../.antigravity/scripts/open-pr-on-goal.js",
        "timeout": 30
      }
    ]
  }
}
